      "contentStyles": {
        "fontFamily": "'Ubuntu', sans-serif",
        "fontSize": "19px",
        "lineHeight": "1.2",
        "fontStyle": "normal",
        "color": "#3f3f3f",
        "textAlign": "left"
      }
    },
