{
  "$schema": "../section-styles.schema.json",
  "description": "Configuration for section-specific styling in email templates. Adjacency mail sections are overridden at build time from lib/adjacency-mail/adjacency-mail-theme-tokens.mjs.",
  "version": "1.0.0",
  
  "sectionStyles": {
    "header": {
      "name": "Header Section",
      "description": "Header quote, author, and featured artist text styles",
      "containerStyles": {
        "backgroundColor": null,
        "padding": "20px"
      },
      "contentStyles": {
        "fontFamily": "'IBM Plex Sans', sans-serif",
        "fontSize": "18px",
        "lineHeight": "23px",
        "fontWeight": "400",
        "color": "#000000",
        "authorFontSize": "16px",
        "authorFontWeight": "600",
        "artistFontSize": "16px",
        "quoteImageGap": "24px",
        "anchorColor": "#000000"
      }
    },
    "intro-content": {
      "name": "Intro Content",
      "description": "Intro paragraph block content styles",
      "containerStyles": {
        "backgroundColor": null,
        "padding": "0",
        "borderRadius": "0px"
      },
      "contentStyles": {
        "fontFamily": "'Roboto', sans-serif",
        "fontSize": "19px",
        "lineHeight": "1.5",
        "fontWeight": "500",
        "color": "#000000",
        "textAlign": "left"
