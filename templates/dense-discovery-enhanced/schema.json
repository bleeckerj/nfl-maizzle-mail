{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Newsletter Data Schema",
  "description": "Schema for newsletter content data",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Newsletter title"
    },
    "subtitle": {
      "type": "string",
      "description": "Newsletter subtitle or preview"
    }
  },
  "required": [
    "title"
  ]
}