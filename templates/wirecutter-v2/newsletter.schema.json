{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wirecutter V2 Newsletter Data Schema",
  "description": "Data contract for the Wirecutter V2 static newsletter template.",
  "type": "object",
  "additionalProperties": true,
  "required": ["template", "title", "header", "featuredArticle", "article", "productShowcase", "footer"],
  "definitions": {
    "trackedLink": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "href": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "category": { "type": "string", "minLength": 1 }
          },
          "anyOf": [
            { "required": ["href"] },
            { "required": ["url"] }
          ]
        }
      ]
    }
  },
  "properties": {
    "template": {
      "const": "wirecutter-v2"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "preheader": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "markdownContent": {
      "type": "string"
    },
    "header": {
      "type": "object",
      "required": ["logoImage", "logoImageMobile", "homepageLink"],
      "properties": {
        "logoImage": { "type": "string", "minLength": 1 },
        "logoImageMobile": { "type": "string", "minLength": 1 },
        "homepageLink": { "$ref": "#/definitions/trackedLink" }
      }
    },
    "featuredArticle": {
      "type": "object",
      "required": ["headline", "heroImage", "heroImageAlt", "description", "ctaLink"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "heroImage": { "type": "string", "minLength": 1 },
        "heroImageAlt": { "type": "string" },
        "photoCredit": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "ctaLink": { "$ref": "#/definitions/trackedLink" },
        "disclaimer": { "type": "string" }
      }
    },
    "article": {
      "type": "object",
      "required": ["title", "image", "imageAlt", "content", "link"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "imageAlt": { "type": "string" },
        "photoCredit": { "type": "string" },
        "content": { "type": "string", "minLength": 1 },
        "link": { "$ref": "#/definitions/trackedLink" }
      }
    },
    "productShowcase": {
      "type": "object",
      "required": ["sectionTitle", "sectionLink", "items"],
      "properties": {
        "sectionTitle": { "type": "string", "minLength": 1 },
        "sectionLink": { "$ref": "#/definitions/trackedLink" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "image", "imageAlt", "description", "link"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "image": { "type": "string", "minLength": 1 },
              "imageAlt": { "type": "string" },
              "description": { "type": "string", "minLength": 1 },
              "link": { "$ref": "#/definitions/trackedLink" }
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "required": ["companyLogo", "unsubscribeText", "companyAddress", "legalLinks"],
      "properties": {
        "companyLogo": { "type": "string", "minLength": 1 },
        "unsubscribeText": { "type": "string", "minLength": 1 },
        "companyAddress": { "type": "string", "minLength": 1 },
        "legalLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "url"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "url": { "$ref": "#/definitions/trackedLink" }
            }
          }
        }
      }
    }
  }
}
