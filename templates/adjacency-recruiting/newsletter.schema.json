{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The Adjacency recruiting email",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "template": {
      "const": "adjacency-recruiting"
    },
    "publicationMode": {
      "const": "campaign"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "preheader": {
      "type": "string",
      "minLength": 1
    },
    "recruiter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "desk": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "desk",
        "signature"
      ]
    },
    "greeting": {
      "type": "string",
      "minLength": 1
    },
    "introduction": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "department": {
          "type": "string",
          "minLength": 1
        },
        "team": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "assignment": {
          "type": "string",
          "minLength": 1
        },
        "compensation": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            },
            "src": {
              "type": "string",
              "pattern": "^https://imagedelivery\\.net/",
              "examples": [
                "https://imagedelivery.net/gaLGizR3kCgx5yRLtiRIOw/fd5a4313-345b-40d9-d9c6-b1a9227b7900/full"
              ]
            }
          },
          "required": [
            "src",
            "alt",
            "width",
            "height",
            "caption"
          ]
        },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "href": {
              "type": "string",
              "pattern": "^https://theadjacency\\.com(?:/|$)",
              "examples": [
                "https://theadjacency.com/subscribe"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "const": "jobs"
            }
          },
          "required": [
            "href",
            "label",
            "category"
          ]
        },
        "ctaLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "company",
        "reference",
        "department",
        "team",
        "facts",
        "mission",
        "assignment",
        "compensation",
        "link",
        "ctaLabel"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "recruiting-list"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "required": [
          "type",
          "title",
          "items"
        ]
      }
    },
    "followUp": {
      "type": "string",
      "minLength": 1
    },
    "operatorContext": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "heading",
        "paragraphs"
      ],
      "description": "Optional operator-authored context. Omit to preserve immersion. Never populated from job provenance automatically.",
      "default": null
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "unsubscribeLink": {
          "type": "string",
          "pattern": "^(\\[unsubscribe\\]|https://)",
          "examples": [
            "[unsubscribe]"
          ]
        },
        "footerCta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false
            }
          },
          "required": [
            "enabled"
          ]
        }
      },
      "required": [
        "identity",
        "footerCta"
      ]
    }
  },
  "required": [
    "template",
    "publicationMode",
    "title",
    "preheader",
    "recruiter",
    "greeting",
    "introduction",
    "job",
    "sections",
    "followUp",
    "footer"
  ]
}
