{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standard Correspondence Email",
  "description": "Personal one-on-one correspondence, not a mass newsletter. No unsubscribe, subscription, archive, or view-online controls are generated.",
  "type": "object",
  "required": ["template", "subject", "correspondence"],
  "additionalProperties": false,
  "properties": {
    "template": {
      "const": "standard-correspondence"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "preheader": {
      "type": "string"
    },
    "correspondence": {
      "type": "object",
      "required": ["subject", "bodyHtml", "theme"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "preheader": { "type": "string" },
        "bodyHtml": { "type": "string", "minLength": 1, "description": "Email body HTML. Markdown bullet and numbered lists are normalized to a numbered register with literal zero-padded labels, table-cell gutters, and list/listitem accessibility roles. Ordered Markdown preserves its starting number. Explicit bodyHtml remains author-controlled." },
        "signatureHtml": { "type": "string", "description": "Personal sign-off; links use the body text color without underlines." },
        "sharedItemsHeading": { "type": "string" },
        "sharedItems": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["title", "href"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "role": { "type": "string", "minLength": 1 },
              "content": {
                "$ref": "#/definitions/contentAttribution"
              },
              "image": {
                "type": ["object", "null"],
                "required": ["src", "alt"],
                "additionalProperties": false,
                "properties": {
                  "src": { "type": "string", "minLength": 1 },
                  "alt": { "type": "string" }
                }
              },
              "descriptionHtml": { "type": "string" }
            }
          }
        },
        "sharedItemRows": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["title", "href"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "href": { "type": "string", "minLength": 1 },
                "label": { "type": "string" },
                "role": { "type": "string", "minLength": 1 },
                "content": {
                  "$ref": "#/definitions/contentAttribution"
                },
                "image": {
                  "type": ["object", "null"],
                  "required": ["src", "alt"],
                  "additionalProperties": false,
                  "properties": {
                    "src": { "type": "string", "minLength": 1 },
                    "alt": { "type": "string" }
                  }
                },
                "descriptionHtml": { "type": "string" }
              }
            }
          }
        },
        "footerNote": { "type": "string", "default": "", "description": "Explicitly authored personal note only. No reply instruction or subscription boilerplate is injected." },
        "footerIconAttribution": { "type": "boolean", "description": "Build-owned flag retaining Icons8 credit when footer icons use img.icons8.com." },
        "footerLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["href", "label"],
            "additionalProperties": false,
            "properties": {
              "href": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "icon": {
                "type": ["object", "null"],
                "required": ["src", "alt"],
                "additionalProperties": false,
                "properties": {
                  "src": { "type": "string", "minLength": 1 },
                  "alt": { "type": "string" }
                }
              }
            }
          }
        },
        "from": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "role": { "type": "string" },
            "organization": { "type": "string" },
            "email": { "type": "string" }
          }
        },
        "showSubject": { "type": "boolean" },
        "showFromHeader": { "type": "boolean" },
        "sourcePath": { "type": "string" },
        "theme": {
          "type": "object",
          "required": [
            "backgroundColor",
            "surfaceColor",
            "textColor",
            "mutedTextColor",
            "linkColor",
            "borderColor",
            "accentColor",
            "fontFamily",
            "serifFontFamily"
          ],
          "additionalProperties": true,
          "properties": {
            "backgroundColor": { "type": "string" },
            "surfaceColor": { "type": "string" },
            "textColor": { "type": "string" },
            "mutedTextColor": { "type": "string" },
            "linkColor": { "type": "string" },
            "borderColor": { "type": "string" },
            "accentColor": { "type": "string" },
            "fontFamily": { "type": "string", "default": "Courier New, Courier, monospace", "description": "Font stack applied to correspondence text and table cells, including register labels. Explicit theme overrides are preserved." },
            "serifFontFamily": { "type": "string", "default": "Courier New, Courier, monospace", "description": "Legacy theme field retained for compatibility; the standard correspondence template uses fontFamily throughout." }
          }
        }
      }
    }
  },
  "definitions": {
    "contentAttribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
