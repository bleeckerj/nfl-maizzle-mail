{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Newsletter Data Schema",
  "description": "Generated schema for newsletter template data",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Newsletter title"
    },
    "preheader": {
      "type": "string",
      "description": "Email preview text"
    },
    "articleItems": {
      "type": "array",
      "description": "Main article content with title, commentary, and quotes",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Article title"
          },
          "url": {
            "type": "string",
            "description": "Link to original article",
            "format": "uri"
          },
          "commentary": {
            "type": "html",
            "description": "Author's commentary on the article"
          },
          "quotes": {
            "type": "array",
            "description": "Pull quotes from the article"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}