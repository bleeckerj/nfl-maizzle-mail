        },
        "location": {
          "type": "string",
          "examples": [
            "Example Location"
          ]
        },
        "url": {
          "$ref": "#/definitions/trackedLink"
        },
        "calendarLabel": {
          "type": "string",
          "examples": [
            "Example Calendar label"
          ]
        },
        "calendarLink": {
          "$ref": "#/definitions/trackedLink"
        },
        "eventLabel": {
          "type": "string",
          "examples": [
            "Example Event label"
          ]
        },
        "eventLink": {
          "$ref": "#/definitions/trackedLink"
        },
        "displayDate": {
          "type": "string",
          "examples": [
            "January 1, 2026"
          ]
        },
        "displayTime": {
          "type": "string",
          "examples": [
            "10:00 AM"
          ]
        },
        "displayWeekday": {
          "type": "string",
          "examples": [
            "Thursday"
          ]
        },
        "containerStyles": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "backgroundColor": {
              "type": "string",
              "examples": [
                "#ffffff"
              ]
            },
            "textColor": {
              "type": "string",
              "examples": [
                "#111111"
              ]
            },
            "headingColor": {
              "type": "string",
              "examples": [
                "#111111"
              ]
            },
            "eyebrowColor": {
              "type": "string",
              "examples": [
                "#111111"
              ]
            },
            "dateColor": {
              "type": "string",
              "examples": [
                "#111111"
              ]
            },
            "timeColor": {
              "type": "string",
              "examples": [
                "#111111"
              ]
            },
            "locationColor": {
              "type": "string",
              "examples": [
