        "renderFor": {
          "type": "string",
          "enum": [
            "public",
            "preview",
            "full",
            "both"
          ],
          "description": "Edition visibility. Omit or use both to render in both editions; public and preview mean the public preview only."
        },
        "label": {
          "type": "string",
          "examples": [
            "Example Label"
          ]
        },
        "title": {
          "type": "string",
          "examples": [
            "Newsletter Title"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "examples": [
