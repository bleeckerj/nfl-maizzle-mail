{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brain Dead Content Email",
  "type": "object",
  "required": [
    "template",
    "title"
  ],
  "anyOf": [
    {
      "required": [
        "sections"
      ]
    },
    {
      "required": [
        "books"
      ]
    },
    {
      "required": [
        "productImages"
      ]
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "examples": [
        "https://json-schema.org/draft-07/schema#"
      ]
    },
    "publicationMode": {
      "enum": [
        "public-issue",
        "campaign"
      ]
    },
    "template": {
      "type": "string",
      "const": "brain-dead-template"
    },
    "title": {
      "type": "string",
      "examples": [
        "Newsletter Title"
      ]
    },
    "preheader": {
      "type": "string",
      "examples": [
        "Short preview text that appears in email clients"
      ]
    },
    "issueId": {
      "type": "string",
      "examples": [
        "w01-y26"
      ]
    },
    "markdownContent": {
      "type": "string",
      "examples": [
        "Example Markdown content"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/contentSection"
      }
    },
    "booksLabel": {
      "type": "string",
      "description": "Deprecated legacy label for the former books array. Use sections[].label instead.",
      "examples": [
        "Deprecated legacy label for the former books array. Use sections[].label instead."
      ]
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "Example Name"
          ]
        },
        "logoUrl": {
          "type": "string",
          "format": "uri",
          "examples": [
            "https://fpoimg.com/200x50?text=Logo%20url&bg_color=e6e6e6&text_color=4FAAAA"
          ]
        },
        "logoAlt": {
          "type": "string",
          "examples": [
            "Image description for accessibility"
          ]
        },
        "logoWidth": {
          "type": [
            "string",
            "number"
          ],
          "examples": [
            "200"
          ]
        },
        "logoLink": {
          "$ref": "#/definitions/trackedLink"
        },
        "navLinks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/navLink"
          }
        }
      }
    },
    "hero": {
      "type": "object",
      "required": [
        "headline"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "examples": [
            "Example Eyebrow"
          ]
        },
        "headline": {
          "type": "string",
          "examples": [
            "Example Headline"
          ]
        },
        "headlineSize": {
          "type": "string",
          "enum": [
            "default",
            "compact"
          ],
          "deprecated": true,
          "description": "Legacy compatibility field; both values now use the template default of 32px desktop / 22px mobile. All section and offer headlines use 22px."
        },
        "subhead": {
          "type": "string",
          "examples": [
            "Example Subhead"
          ]
        },
        "body": {
          "type": "string",
          "examples": [
            "<p>Example Body content.</p>"
          ]
        },
        "image": {
          "type": "string",
          "format": "uri",
          "examples": [
            "https://fpoimg.com/800x600?text=Image&bg_color=e6e6e6&text_color=4FAAAA"
          ]
        },
        "imageAlt": {
          "type": "string",
          "examples": [
            "Image description for accessibility"
          ]
        },
        "imageLink": {
          "oneOf": [
            {
              "const": "none"
            },
            {
              "$ref": "#/definitions/trackedLink"
            }
          ],
          "description": "Optional image destination override. When omitted, the hero image uses hero.ctaLink, then legacy shopLink. Use 'none' to keep the hero image unlinked; tracked link objects are normalized to their href during the build."
        },
        "ctaText": {
          "type": "string",
          "examples": [
            "Read more"
          ]
        },
        "ctaLink": {
          "$ref": "#/definitions/trackedLink"
        }
      }
    },
    "books": {
      "type": "array",
      "description": "Deprecated legacy dual-column items. Use sections[] with type dual-column instead.",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/contentItem"
      }
    },
    "offer": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string",
          "examples": [
            "Example Eyebrow"
          ]
        },
        "headline": {
          "type": "string",
          "examples": [
            "Example Headline"
          ]
        },
        "body": {
          "type": "string",
          "examples": [
            "<p>Example Body content.</p>"
          ]
        },
        "ctaText": {
          "type": "string",
          "examples": [
            "Read more"
          ]
        },
        "ctaLink": {
          "$ref": "#/definitions/trackedLink"
        }
      }
    },
    "bottomCta": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string",
          "examples": [
            "Example Eyebrow"
          ]
        },
        "headline": {
          "type": "string",
          "examples": [
            "Example Headline"
          ]
        },
        "body": {
          "type": "string",
          "examples": [
            "<p>Example Body content.</p>"
          ]
        },
        "ctaText": {
          "type": "string",
          "examples": [
            "Read more"
          ]
        },
        "ctaLink": {
          "$ref": "#/definitions/trackedLink"
        }
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string",
            "examples": [
              "Example Paragraphs"
            ]
          }
        },
        "address": {
          "type": "string",
          "examples": [
            "© 2025 Your Company<br>City, State<br>Country"
          ]
        },
        "socialLinks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/socialLink"
          }
        },
        "footerCta": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "variant": {
              "type": "string",
              "examples": [
                "Example Variant"
              ]
            }
          }
        },
        "unsubscribeLabel": {
          "type": "string",
          "examples": [
            "Example Unsubscribe label"
          ]
        },
        "unsubscribeLink": {
          "type": "string",
          "examples": [
            "[unsubscribe]"
          ],
          "default": "[unsubscribe]"
        }
      }
    },
    "logoUrl": {
      "type": "string",
      "format": "uri",
      "examples": [
        "https://fpoimg.com/200x50?text=Logo%20url&bg_color=e6e6e6&text_color=4FAAAA"
      ]
    },
    "logoAlt": {
      "type": "string",
      "examples": [
        "Image description for accessibility"
      ]
    },
    "logoWidth": {
      "type": [
        "string",
        "number"
      ],
      "examples": [
        "200"
      ]
    },
    "logoLink": {
      "$ref": "#/definitions/trackedLink"
    },
    "collectionTitle": {
      "type": "string",
      "examples": [
        "Example Collection title"
      ]
    },
    "collectionDescription": {
      "type": "string",
      "examples": [
        "Example Collection description"
      ]
    },
    "collectionDetails": {
      "type": "string",
      "examples": [
        "Example Collection details"
      ]
    },
    "mainImage": {
      "type": "string",
      "format": "uri",
      "examples": [
        "https://fpoimg.com/800x600?text=Main%20image&bg_color=e6e6e6&text_color=4FAAAA"
      ]
    },
    "productImages": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "examples": [
          "https://fpoimg.com/800x600?text=Product%20images&bg_color=e6e6e6&text_color=4FAAAA"
        ]
      }
    },
    "shopLink": {
      "$ref": "#/definitions/trackedLink"
    },
    "socialLinks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/socialLink"
      }
    }
  },
  "definitions": {
    "contentSection": {
      "type": "object",
      "required": [
        "type"
