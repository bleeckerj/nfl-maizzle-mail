{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brain Dead Content Email",
  "type": "object",
  "required": ["template", "title"],
  "anyOf": [
    { "required": ["sections"] },
    { "required": ["books"] },
    { "required": ["productImages"] }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "template": { "const": "brain-dead-template" },
    "title": { "type": "string" },
    "preheader": { "type": "string" },
    "issueId": { "type": "string" },
    "markdownContent": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/contentSection" }
    },
    "booksLabel": {
      "type": "string",
      "description": "Deprecated legacy label for the former books array. Use sections[].label instead."
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "logoAlt": { "type": "string" },
        "logoWidth": { "type": ["string", "number"] },
        "logoLink": { "$ref": "#/definitions/trackedLink" },
        "navLinks": {
          "type": "array",
          "items": { "$ref": "#/definitions/navLink" }
        }
      }
    },
    "hero": {
      "type": "object",
      "required": ["headline"],
      "properties": {
        "eyebrow": { "type": "string" },
        "headline": { "type": "string" },
        "subhead": { "type": "string" },
        "body": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "imageAlt": { "type": "string" },
        "ctaText": { "type": "string" },
        "ctaLink": { "$ref": "#/definitions/trackedLink" }
      }
    },
    "books": {
      "type": "array",
      "description": "Deprecated legacy dual-column items. Use sections[] with type dual-column instead.",
      "minItems": 1,
      "items": { "$ref": "#/definitions/contentItem" }
    },
    "offer": {
      "type": "object",
      "properties": {
        "eyebrow": { "type": "string" },
        "headline": { "type": "string" },
        "body": { "type": "string" },
        "ctaText": { "type": "string" },
        "ctaLink": { "$ref": "#/definitions/trackedLink" }
      }
    },
    "bottomCta": {
      "type": "object",
      "properties": {
        "eyebrow": { "type": "string" },
        "headline": { "type": "string" },
        "body": { "type": "string" },
        "ctaText": { "type": "string" },
        "ctaLink": { "$ref": "#/definitions/trackedLink" }
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "paragraphs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "address": { "type": "string" },
        "socialLinks": {
          "type": "array",
          "items": { "$ref": "#/definitions/socialLink" }
        },
        "footerCta": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "variant": { "type": "string" }
          }
        },
        "unsubscribeLabel": { "type": "string" },
        "unsubscribeLink": { "type": "string" }
      }
    },
    "logoUrl": { "type": "string", "format": "uri" },
    "logoAlt": { "type": "string" },
    "logoWidth": { "type": ["string", "number"] },
    "logoLink": { "$ref": "#/definitions/trackedLink" },
    "collectionTitle": { "type": "string" },
    "collectionDescription": { "type": "string" },
    "collectionDetails": { "type": "string" },
    "mainImage": { "type": "string", "format": "uri" },
    "productImages": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "shopLink": { "$ref": "#/definitions/trackedLink" },
    "socialLinks": {
      "type": "array",
      "items": { "$ref": "#/definitions/socialLink" }
    }
  },
  "definitions": {
    "contentSection": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["dual-column", "single-column", "calendar_event", "inline_cta", "ad-block", "short-take"] },
        "renderFor": {
          "type": "string",
          "enum": ["public", "preview", "full", "both"],
          "description": "Edition visibility. Omit or use both to render in both editions; public and preview mean the public preview only."
        },
        "label": { "type": "string" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1
        },
        "id": { "type": "string" },
        "eyebrow": { "type": "string" },
        "subtitle": { "type": "string" },
        "startsAt": { "type": "string" },
        "endsAt": { "type": "string" },
        "durationMinutes": { "type": ["integer", "number", "string"] },
        "timezone": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "url": { "$ref": "#/definitions/trackedLink" },
        "calendarLabel": { "type": "string" },
        "calendarLink": { "$ref": "#/definitions/trackedLink" },
        "eventLabel": { "type": "string" },
        "eventLink": { "$ref": "#/definitions/trackedLink" },
        "displayDate": { "type": "string" },
        "displayTime": { "type": "string" },
        "displayWeekday": { "type": "string" },
        "containerStyles": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "backgroundColor": { "type": "string" },
            "textColor": { "type": "string" },
            "headingColor": { "type": "string" },
            "eyebrowColor": { "type": "string" },
            "dateColor": { "type": "string" },
            "timeColor": { "type": "string" },
            "locationColor": { "type": "string" },
            "borderColor": { "type": "string" },
            "borderWidth": { "type": "string" },
            "dividerColor": { "type": "string" },
            "dividerWidth": { "type": "string" },
            "headerPadding": { "type": "string" },
            "bodyPadding": { "type": "string" },
            "buttonBackgroundColor": { "type": "string" },
            "buttonTextColor": { "type": "string" },
            "buttonBorderColor": { "type": "string" },
            "buttonBorderWidth": { "type": "string" },
            "buttonPadding": { "type": "string" },
            "secondaryLinkColor": { "type": "string" }
          }
        },
        "contentStyles": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "fontFamily": { "type": "string" },
            "fontSize": { "type": "string" },
            "lineHeight": { "type": "string" },
            "color": { "type": "string" }
          }
        },
        "eyebrow_color": { "type": "string" },
        "text_color": { "type": "string" },
        "background": { "type": "string" },
        "border_color": { "type": "string" },
        "border_width": { "type": ["integer", "string"] },
        "border_radius": { "type": ["integer", "string"] },
        "font_family": { "enum": ["mono", "sans"] },
        "space_top": { "type": ["integer", "string"] },
        "space_bottom": { "type": ["integer", "string"] },
        "button_background": { "type": "string" },
        "button_text_color": { "type": "string" },
        "button_border_color": { "type": "string" },
        "secondary_button_background": { "type": "string" },
        "secondary_button_text_color": { "type": "string" },
        "secondary_button_border_color": { "type": "string" },
        "primaryAction": { "$ref": "#/definitions/inlineCtaAction" },
        "secondaryAction": { "$ref": "#/definitions/inlineCtaAction" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["dual-column", "single-column"] } } },
          "then": {
            "properties": {
              "items": {
                "items": { "$ref": "#/definitions/contentItem" }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "ad-block" } } },
          "then": {
            "properties": {
              "items": {
                "maxItems": 1,
                "items": { "$ref": "#/definitions/adBlockSourceItem" }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "short-take" } } },
          "then": {
            "properties": {
              "items": {
                "maxItems": 1,
                "items": { "$ref": "#/definitions/shortTakeSourceItem" }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "calendar_event" } } },
          "then": { "required": ["title", "startsAt"] },
          "else": {
            "if": { "properties": { "type": { "const": "inline_cta" } } },
            "then": { "required": ["primaryAction"] },
            "else": { "required": ["items"] }
          }
        }
      ]
    },
    "contentItem": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "kicker": { "type": "string" },
        "format": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "body": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "imageAlt": { "type": "string" },
        "price": { "type": "string" },
        "link": { "$ref": "#/definitions/trackedLink" },
        "ctaText": { "type": "string" }
      }
    },
    "adBlockSourceItem": {
      "type": "object",
      "required": ["adId"],
      "properties": {
        "adId": { "type": "string", "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "shortTakeSourceItem": {
      "type": "object",
      "required": ["shortTakeId"],
      "properties": {
        "shortTakeId": { "type": "string", "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "trackedLink": {
      "oneOf": [
        { "type": "string", "format": "uri" },
        {
          "type": "object",
          "required": ["href"],
          "properties": {
            "href": { "type": "string", "format": "uri" },
            "url": { "type": "string", "format": "uri" },
            "label": { "type": "string" },
            "category": { "type": "string" },
            "interest": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ]
            },
            "interests": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ]
            },
            "intent": { "type": "string" }
          }
        }
      ]
    },
    "inlineCtaAction": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string" },
        "url": { "$ref": "#/definitions/trackedLink" }
      },
      "additionalProperties": true
    },
    "navLink": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "text": { "type": "string" },
        "href": { "$ref": "#/definitions/trackedLink" },
        "url": { "$ref": "#/definitions/trackedLink" }
      }
    },
    "socialLink": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string" },
        "text": { "type": "string" },
        "title": { "type": "string" },
        "href": { "$ref": "#/definitions/trackedLink" },
        "url": { "$ref": "#/definitions/trackedLink" }
      }
    }
  }
}
