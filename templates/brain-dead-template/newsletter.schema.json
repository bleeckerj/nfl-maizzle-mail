              ]
            },
            "borderWidth": {
              "type": "string",
              "examples": [
                "1px"
              ]
            },
            "dividerColor": {
              "type": "string",
              "examples": [
                "#d1d5db"
              ]
            },
            "dividerWidth": {
              "type": "string",
              "examples": [
                "1px"
              ]
            },
            "headerPadding": {
              "type": "string",
              "examples": [
                "16px"
              ]
            },
            "bodyPadding": {
              "type": "string",
              "examples": [
                "16px"
              ]
            },
            "buttonBackgroundColor": {
              "type": "string",
              "examples": [
                "#ffffff"
              ]
            },
            "buttonTextColor": {
              "type": "string",
              "examples": [
                "#111111"
              ]
            },
            "buttonBorderColor": {
              "type": "string",
              "examples": [
