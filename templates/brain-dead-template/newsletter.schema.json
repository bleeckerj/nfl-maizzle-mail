          "type": "string",
          "examples": [
            "#ffffff"
          ]
        },
        "border_color": {
          "type": "string",
          "examples": [
            "#d1d5db"
          ]
        },
        "border_width": {
          "type": [
            "integer",
            "string"
          ],
          "examples": [
            600
          ]
        },
        "border_radius": {
          "type": [
            "integer",
            "string"
          ],
          "examples": [
            8
          ]
        },
        "font_family": {
          "type": "string",
          "minLength": 1,
          "default": "mono",
          "description": "Use mono, sans, or a CSS font-family stack."
        },
        "space_top": {
          "type": [
            "integer",
            "string"
          ],
          "examples": [
            16
          ]
        },
        "space_bottom": {
          "type": [
            "integer",
            "string"
          ],
          "examples": [
            16
          ]
        },
        "button_background": {
          "type": "string",
          "examples": [
            "#111111"
          ]
        },
        "button_text_color": {
          "type": "string",
          "examples": [
            "#111111"
          ]
        },
        "button_border_color": {
          "type": "string",
          "examples": [
            "#d1d5db"
          ]
        },
        "secondary_button_background": {
          "type": "string",
          "examples": [
            "#111111"
          ]
        },
        "secondary_button_text_color": {
          "type": "string",
          "examples": [
            "#111111"
          ]
        },
        "secondary_button_border_color": {
          "type": "string",
          "examples": [
            "#d1d5db"
          ]
        },
        "primaryAction": {
          "$ref": "#/definitions/inlineCtaAction"
        },
        "secondaryAction": {
          "$ref": "#/definitions/inlineCtaAction"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "dual-column",
                  "single-column"
                ]
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/definitions/contentItem"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ad-block"
              }
            },
            "x-nfl-authoring": {
              "sectionFields": [
                "type",
                "title",
                "description",
                "show_top_rule",
                "show_bottom_rule",
                "items"
              ],
              "itemFields": [
                "adId"
              ],
              "requiredSectionFields": [
                "type",
                "items"
              ],
              "requiredItemFields": [
                "adId"
              ]
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "items": {
                "maxItems": 1,
                "items": {
                  "$ref": "#/definitions/adBlockSourceItem"
                },
                "type": "array"
              }
            },
            "x-nfl-authoring": {
              "sectionFields": [
                "type",
                "title",
                "description",
                "show_top_rule",
                "show_bottom_rule",
                "items"
              ],
              "itemFields": [
                "adId"
              ],
              "requiredSectionFields": [
                "type",
                "items"
              ],
              "requiredItemFields": [
                "adId"
              ]
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "short-take"
              }
            },
            "x-nfl-authoring": {
              "sectionFields": [
                "type",
                "title",
                "description",
                "items"
              ],
              "itemFields": [
                "shortTakeId"
              ],
              "requiredSectionFields": [
                "type",
                "items"
              ],
              "requiredItemFields": [
                "shortTakeId"
              ]
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "items": {
                "maxItems": 1,
                "items": {
                  "$ref": "#/definitions/shortTakeSourceItem"
                },
                "type": "array",
                "description": "Hydrates the canonical Geist Bold SHORT TAKES brand rail from the registry; lockup.brandRail: false omits the complete rail. Footer CTAs link to the record destination when one is present."
              }
            },
            "x-nfl-authoring": {
              "sectionFields": [
                "type",
                "title",
                "description",
                "items"
              ],
              "itemFields": [
                "shortTakeId"
              ],
              "requiredSectionFields": [
                "type",
                "items"
              ],
              "requiredItemFields": [
                "shortTakeId"
              ]
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "calendar_event"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "title",
              "startsAt"
            ]
          },
          "else": {
            "if": {
              "properties": {
                "type": {
                  "const": "inline_cta"
                },
                "button_border_width": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "minimum": 0,
                  "pattern": "^(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:px)?$",
                  "default": 2,
                  "description": "Button border width. Accepts a nonnegative pixel number or px string, including zero and decimals."
                },
                "secondary_button_border_width": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "minimum": 0,
                  "pattern": "^(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:px)?$",
                  "default": 2,
                  "description": "Button border width. Accepts a nonnegative pixel number or px string, including zero and decimals."
                }
              },
              "type": "object"
            },
            "then": {
              "required": [
                "primaryAction"
              ]
            },
            "else": {
              "if": {
                "properties": {
                  "type": {
                    "enum": [
                      "ad-slot",
                      "short-take-slot"
                    ]
                  }
                },
                "type": "object"
              },
              "then": {},
              "else": {
                "required": [
                  "items"
                ]
              }
            }
          }
        }
      ]
    },
