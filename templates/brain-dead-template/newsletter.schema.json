                "16px"
              ]
            },
            "secondaryLinkColor": {
              "type": "string",
              "examples": [
                "#111111"
              ]
            }
          }
        },
        "contentStyles": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "fontFamily": {
              "type": "string",
              "examples": [
                "Arial, Helvetica, sans-serif"
              ]
            },
            "fontSize": {
              "type": "string",
              "examples": [
                "16px"
              ]
            },
            "lineHeight": {
              "type": "string",
              "examples": [
