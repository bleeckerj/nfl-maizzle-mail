{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Google DeepMind Special Projects recruiting email",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "template": {
      "type": "string",
      "const": "gdm-special-projects"
    },
    "publicationMode": {
      "const": "campaign"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "Newsletter Title"
      ]
    },
    "preheader": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "Short preview text that appears in email clients"
      ]
    },
    "recruiter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Hiring organization identity in the signature; the hosted company logo leads the masthead.",
          "examples": [
            "Example Name"
          ]
        },
        "desk": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Desk"
          ]
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Signature"
          ]
        }
      },
      "required": [
        "name",
        "desk",
        "signature"
      ]
    },
    "greeting": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "Example Greeting"
      ]
    },
    "introduction": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "examples": [
          "Example Introduction"
        ]
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Newsletter Title"
          ]
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Company"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Reference"
          ]
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Department"
          ]
        },
        "team": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Team"
          ]
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "examples": [
                  "Example Label"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "examples": [
                  "Example Value"
                ]
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "mission": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Mission"
          ]
        },
        "assignment": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Assignment"
          ]
        },
        "compensation": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Compensation"
          ]
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alt": {
              "type": "string",
              "minLength": 1,
              "examples": [
                "Image description for accessibility"
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "examples": [
                600
              ]
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "examples": [
                400
              ]
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "examples": [
                "Example Caption"
              ]
            },
            "src": {
              "type": "string",
              "pattern": "^https://imagedelivery\\.net/",
              "examples": [
                "https://imagedelivery.net/gaLGizR3kCgx5yRLtiRIOw/fd5a4313-345b-40d9-d9c6-b1a9227b7900/full"
              ]
            }
          },
          "required": [
            "src",
            "alt"
          ]
        },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "href": {
              "type": "string",
              "pattern": "^https://theadjacency\\.com(?:/|$)",
              "examples": [
                "https://theadjacency.com/subscribe"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "examples": [
                "Example Label"
              ]
            },
            "category": {
              "const": "jobs"
            }
          },
          "required": [
            "href",
            "label",
            "category"
          ]
        },
        "ctaLabel": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Read more"
          ]
        }
      },
      "required": [
        "title",
        "company",
        "reference",
        "department",
        "team",
        "facts",
        "mission",
        "assignment",
        "compensation",
        "link",
        "ctaLabel"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "recruiting-list"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "examples": [
                  "Newsletter Title"
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "examples": [
                        "Example Text"
                      ]
                    }
                  }
                }
              }
            },
            "required": [
              "type",
              "title",
              "items"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "ad-block"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "adId": {
                      "description": "Editorial inventory ID. Commerce ads use the shared Compact Band with full image, live commerce fields, and sponsor.",
                      "type": "string",
                      "minLength": 1,
                      "examples": [
                        "fluke-turing-clamp-4x5-01"
                      ]
                    }
                  },
                  "required": [
                    "adId"
                  ]
                }
              },
              "placement": {
                "type": "string",
                "enum": [
                  "top",
                  "after-introduction",
                  "after-role",
                  "after-assignment",
                  "inline",
                  "after-lists",
                  "after-compensation",
                  "after-recruiting",
                  "after-explainer",
                  "after-share"
                ],
                "default": "after-recruiting",
                "description": "Sponsor position. Inline follows sections array order among recruiting lists. Omission preserves the legacy position after the recruiter follow-up."
              },
              "sponsorLabel": {
                "type": "string",
                "minLength": 1,
                "description": "Deprecated; retained for source compatibility but does not render a heading. Use label.",
                "examples": [
                  "Deprecated; retained for source compatibility but does not render a heading. Use label."
                ]
              },
              "label": {
                "type": "string",
                "description": "Optional ad-block heading. Rendered only when explicitly supplied and non-empty; no default.",
                "examples": [
                  "Optional ad-block heading. Rendered only when explicitly supplied and non-empty; no default."
                ]
              }
            },
            "required": [
              "type",
              "items"
            ],
            "x-nfl-authoring": {
              "sectionFields": [
                "type",
                "title",
                "description",
                "show_top_rule",
                "show_bottom_rule",
                "items"
              ],
              "itemFields": [
                "adId"
              ],
              "requiredSectionFields": [
                "type",
                "items"
              ],
              "requiredItemFields": [
                "adId"
              ]
            }
          }
        ]
      }
    },
    "followUp": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "Example Follow up"
      ]
    },
    "operatorContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Heading"
          ]
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "examples": [
              "Example Paragraphs"
            ]
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "examples": [
                  "Example Text"
                ]
              },
              "link": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "href": {
                    "type": "string",
                    "pattern": "^https://",
                    "examples": [
                      "https://nearfuturelaboratory.com/artifacts/food-drug-and-algorithm-administration/"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "examples": [
                      "Example Label"
                    ]
                  },
                  "category": {
                    "const": "grounding"
                  }
                },
                "required": [
                  "href",
                  "label",
                  "category"
                ]
              }
            },
            "required": [
              "text",
              "link"
            ]
          }
        }
      },
      "required": [
        "heading",
        "paragraphs"
      ],
      "description": "Required operator explainer, visually separate after the recruiting message."
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "description": "Publication footer identity linked to https://theadjacency.com/subscribe.",
          "examples": [
            "Publication footer identity linked to https://theadjacency.com/subscribe."
          ]
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "© 2025 Your Company<br>City, State<br>Country"
          ]
        },
        "unsubscribeLink": {
          "type": "string",
          "pattern": "^(\\[unsubscribe\\]|https://)",
          "examples": [
            "[unsubscribe]"
          ],
          "default": "[unsubscribe]"
        },
        "footerCta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false
            }
          },
          "required": [
            "enabled"
          ]
        }
      },
      "required": [
        "identity",
        "footerCta"
      ]
    },
    "share": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "default": "Share this"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Text"
          ]
        },
        "buttonLabel": {
          "type": "string",
          "minLength": 1,
          "default": "Share by email"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Subject"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Example Message"
          ]
        },
        "emailHref": {
          "type": "string",
          "readOnly": true,
          "description": "Build-generated mailto URI from subject, message, and job.link. Pruned before schema validation and authoring export."
        }
      },
      "required": [
        "enabled",
        "heading",
        "text",
        "buttonLabel",
        "subject",
        "message"
      ]
    },
    "companyLogo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^https://imagedelivery\\.net/",
          "examples": [
            "https://imagedelivery.net/gaLGizR3kCgx5yRLtiRIOw/1c9b8ab8-1efb-4c0b-9b91-8c92e122ea00/public?format=png"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Image description for accessibility"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "examples": [
            600
          ]
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "examples": [
            400
          ]
        }
      },
      "required": [
        "src",
        "alt",
        "width",
        "height"
      ],
      "description": "Required complete company wordmark. Hosted PNG rendition preferred for email; preserve natural aspect ratio."
    }
  },
  "required": [
    "template",
    "publicationMode",
    "title",
    "preheader",
    "recruiter",
    "greeting",
    "introduction",
    "job",
    "sections",
    "followUp",
    "footer",
    "operatorContext",
    "share",
    "companyLogo"
  ],
  "x-nfl-contract-version": 1
}
