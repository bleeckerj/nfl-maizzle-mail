{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sentiers Newsletter Template Schema",
  "description": "Schema for Sentiers-style newsletter with articles and miscellany",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Newsletter title"
    },
    "header": {
      "type": "object",
      "description": "Header section with logo and issue number",
      "properties": {
        "viewBrowserUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL for view in browser link"
        },
        "logo": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "format": "uri"
            },
            "alt": {
              "type": "string"
            }
          }
        },
        "issueNumber": {
          "type": "string",
          "description": "Issue number (e.g., 'No.123')"
        }
      }
    },
    "headerContent": {
      "type": "object",
      "description": "Header content summary",
      "properties": {
        "thisWeek": {
          "type": "string",
          "description": "This week's summary"
        },
        "yearAgo": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "headerPrompt": {
      "type": "object",
      "description": "Membership call-to-action prompt",
      "properties": {
        "text": {
          "type": "string",
          "description": "Prompt text"
        },
        "membershipUrl": {
          "type": "string",
          "format": "uri"
        },
        "ctaText": {
          "type": "string",
          "description": "CTA button text"
        }
      }
    },
    "featuredImage": {
      "type": "object",
      "description": "Main featured image",
      "properties": {
        "src": {
          "type": "string",
          "format": "uri"
        },
        "alt": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "articles": {
      "type": "array",
      "description": "Array of newsletter articles",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "content": {
            "type": "string",
            "description": "Article content HTML"
          },
          "blockquotes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "paragraphs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "highlight": {
                        "type": "boolean",
                        "description": "Whether to highlight this paragraph"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "miscellany": {
      "type": "array",
      "description": "Miscellany section items",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "description": "Footer with membership CTA",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "Footer prompt text"
        },
        "membershipUrl": {
          "type": "string",
          "format": "uri"
        },
        "ctaText": {
          "type": "string",
          "description": "CTA button text"
        },
        "legal": {
          "type": "string",
          "description": "Legal/copyright text"
        },
        "unsubscribeUrl": {
          "type": "string",
          "format": "uri"
        },
        "preferencesUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "required": ["title", "header", "articles"]
}