{
  "name": "nfl-maizzle-mail",
  "version": "2.0.0",
  "description": "Reusable HTML email template system built with Maizzle",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-newsletter.mjs data/newsletter.json --no-open",
    "build:data": "node scripts/build-newsletter.mjs data/newsletter.json --no-open",
    "dev": "maizzle serve",
    "build:newsletter": "node scripts/build-newsletter.mjs",
    "build:correspondence": "node scripts/build-correspondence.mjs",
    "serve:correspondence": "node scripts/correspondence-server.mjs",
    "export:normalized-newsletter": "node scripts/export-normalized-newsletter.mjs",
    "quick": "node scripts/quick-build.mjs",
    "factory": "node scripts/email-template-factory/index.mjs",
    "factory:anthropic": "node scripts/email-template-factory/index.mjs --provider=anthropic",
    "factory:openai": "node scripts/email-template-factory/index.mjs --provider=openai",
    "templates:list": "node scripts/template_manager.mjs list",
    "templates:info": "node scripts/template_manager.mjs info",
    "schema:generate": "node scripts/generate-template-schema.mjs",
    "lint:content": "node scripts/lint-template.mjs",
    "test:newsletter-core": "node --test tests/newsletter-core/*.test.mjs",
    "test:microdrop-faithful": "node --test tests/microdrop-faithful/*.test.mjs",
    "test:correspondence": "node --test tests/correspondence-email/*.test.mjs",
    "send:test": "node scripts/send-ses-test.mjs",
    "send:correspondence:test": "node scripts/send-correspondence-test.mjs",
    "gallery": "node scripts/template-gallery.mjs serve",
    "gallery:build": "node scripts/template-gallery.mjs build",
    "test:gallery": "node --test tests/template-gallery/*.test.mjs",
    "test:newsletter-contracts": "node --test --test-concurrency=2 tests/newsletter-core/authoring-contract.test.mjs tests/newsletter-core/template-schema-contract.test.mjs tests/newsletter-core/schema-starter-completeness.test.mjs tests/newsletter-core/starter-placeholder-semantics.test.mjs tests/newsletter-core/inline-cta.test.mjs"
  },
  "keywords": [
    "email",
    "maizzle",
    "newsletter",
    "html",
    "templates"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@aws-sdk/client-ses": "^3.688.0",
    "@maizzle/framework": "^4.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.2.3",
    "js-yaml": "^4.1.0",
    "jsonrepair": "^3.14.0",
    "marked": "11.2.0",
    "nfl-native-lockups": "file:../nfl-backoffice/packages/nfl-native-lockups",
    "openai": "^6.2.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^11.1.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^23.2.0",
    "juice": "^10.0.1",
    "postcss": "^8.5.6"
  }
}
